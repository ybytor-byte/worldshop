{
    "manifest_version": 3,
    "name": "WowS - World Shop Visual Search",
    "version": "1.0",
    "description": "Поиск товаров по всему миру по клику на картинку (WowS WoW World Shop)",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ]
}
