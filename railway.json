{
  "build": {
    "builder": "NIXPACKS",
    "rootDirectory": "backend"
  },
  "deploy": {
    "startCommand": "node backend/node_modules/prisma/build/index.js migrate deploy && node backend/dist/src/main.js",
    "healthcheckPath": "/docs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
